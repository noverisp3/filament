# Cargo build output.
target/

# The reports the data generator produces are several hundred megabytes, most of
# it biome parameters and per-component files nothing here reads. They are
# deleted after each run and never committed. `extracted/`, by contrast, is
# committed: it is the input to `build_tables.py` and needs to be reproducible.
tools/logs/

# Python bytecode from the capture tools.
__pycache__/

# A capture run is a debugging aid, not an input. `captured/packets.bin` and the
# generated `assets/update_tags.bin` are committed; the log and the index are
# not, because regenerating them is one command and they change on every run.
captured/run.log
captured/packets.jsonl

# What the scripted clients write. Unlike captured/play/, which holds the
# reference packets pinned against the client jar, these are the output of a
# probe pointed at whatever is running: which server, what it answered, and a
# verdict that is only true of that run. Nothing reads them twice.
captured/break/
captured/ghost/

# A scratch script: it looks through the decompiled client for the sound
# registrations, which is a question the plan file is still asking. It reads
# the game's source and prints what it finds, and it belongs to the person
# asking rather than to the repository.
_findsounds.py
